# Local development defaults. Copy to backend/.env and edit as needed.
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
CLIENT_IP_MODE=socket
TRUST_PROXY_HOPS=0
RECONNECT_GRACE_PERIOD_MS=120000

# Railway production: set CLIENT_IP_MODE=railway and omit TRUST_PROXY_HOPS.
# This trusts a single valid X-Real-IP only behind Railway's public HTTP edge.
# NODE_ENV=production
# ALLOWED_ORIGINS=https://<actual-https-origin>
# CLIENT_IP_MODE=railway
#
# Other reverse-proxy providers: leave CLIENT_IP_MODE=socket and set
# TRUST_PROXY_HOPS only to a value verified for that provider's topology.
