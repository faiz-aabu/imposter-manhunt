# Copy this file to .env.local and set the backend URL for your development device.
# Android emulator: http://10.0.2.2:3000
# iOS simulator: http://127.0.0.1:3000
# Physical phone: http://<WINDOWS_PC_LAN_IP>:3000
# Production public hosts must use HTTPS (Socket.IO will use WSS).
EXPO_PUBLIC_API_URL=

# Supabase public client configuration. Do not add a service-role or secret key.
# Obtain these values from the Supabase project's API settings.
EXPO_PUBLIC_SUPABASE_URL=
# Prefer PUBLISHABLE_KEY. ANON_KEY is supported as a compatibility alias.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
